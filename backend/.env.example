# Copy to .env and adjust for your environment. Never commit .env itself.

# SQLite file path (relative to backend/ or absolute)
DATABASE_URL=sqlite:///./dev.db

# JWT signing — generate a real random secret for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-every-real-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — the frontend origin(s) allowed to call this API
CORS_ORIGINS=http://localhost:3000

# SMTP (email notifications — doc 10). Leave blank in local dev; sends are
# skipped with a warning log if unset rather than failing hard.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@example.com

ENVIRONMENT=development
