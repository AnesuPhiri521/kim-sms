# Copy to .env.production on the server and fill in real values.
# Never commit .env.production itself.

DATABASE_URL=sqlite:////data/app.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=https://kim.pixelforgeglobal.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@kim.pixelforgeglobal.com

ENVIRONMENT=production

# Login is by email (EmailStr-validated), so the "admin" username must be a
# valid email address — this is the account created by app/db/seed.py.
ADMIN_EMAIL=admin@kim.pixelforgeglobal.com
ADMIN_PASSWORD=admin123
